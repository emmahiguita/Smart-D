<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".PcView">

    <!-- Contenedor Principal con Lienzo de Cristal Ambiental OLED -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_ios_ambient_canvas">

        <!-- Animación de lluvia (solo tema Lluvia) -->
        <com.limelight.ui.RainView
            android:id="@+id/rain_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- CONTENIDO PRINCIPAL: HERO PC + LIQUID START + MIS EQUIPOS        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingTop="66dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="0dp"
                android:paddingBottom="20dp">

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- HERO DYNAMIC ISLAND / LIVE ACTIVITY (Apple iOS 18 Style)   -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/hero_live_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="@null"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ios_live_activity"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp">

                        <!-- Fila Superior: Badge PC + Nombre + Estado + Telemetría -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <!-- Icono / Glifo del PC Activo -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/pcGlyphCard"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                app:cardBackgroundColor="@null"
                                app:cardCornerRadius="13dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:id="@+id/hero_pc_icon"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_ios_badge_squircle"
                                    android:contentDescription="@string/device_icon_desc"
                                    android:padding="8dp"
                                    android:src="@drawable/ic_computer"
                                    app:tint="#0A84FF" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Nombre y Estado en columna -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="10dp"
                                android:layout_toEndOf="@id/pcGlyphCard"
                                android:layout_toStartOf="@+id/performanceCapsule"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/hero_pc_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/roboto"
                                    android:maxLines="1"
                                    android:text="EMMA"
                                    android:textColor="#F5F5F7"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="-0.02"
                                    tools:text="EMMA" />

                                <LinearLayout
                                    android:id="@+id/statusContainer"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <View
                                        android:id="@+id/header_status_dot"
                                        android:layout_width="7dp"
                                        android:layout_height="7dp"
                                        android:background="@drawable/bg_green_dot" />

                                    <TextView
                                        android:id="@+id/hero_status_text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="5dp"
                                        android:fontFamily="@font/roboto"
                                        android:text="Disponible"
                                        android:textColor="#30D158"
                                        android:textSize="11sp"
                                        android:textStyle="bold"
                                        tools:text="Disponible" />

                                    <TextView
                                        android:id="@+id/header_network_text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="5dp"
                                        android:fontFamily="@font/roboto"
                                        android:textColor="#8E8E93"
                                        android:textSize="11sp"
                                        android:visibility="gone"
                                        tools:text="Wi-Fi" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Cápsula de Telemetría (Ping + FPS) Estilo iOS -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/performanceCapsule"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                app:cardBackgroundColor="#47141C2B"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#59FFFFFF"
                                app:strokeWidth="1.2dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp">

                                    <ImageView
                                        android:layout_width="12dp"
                                        android:layout_height="12dp"
                                        android:contentDescription="Latencia"
                                        android:src="@drawable/ic_stat_ping"
                                        app:tint="#30D158" />

                                    <TextView
                                        android:id="@+id/capsuleLatencyText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:fontFamily="@font/roboto"
                                        android:text="8 ms"
                                        android:textColor="#F5F5F7"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        tools:text="8 ms" />

                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="10dp"
                                        android:layout_marginHorizontal="6dp"
                                        android:background="#2EFFFFFF" />

                                    <ImageView
                                        android:layout_width="12dp"
                                        android:layout_height="12dp"
                                        android:contentDescription="Fluidez"
                                        android:src="@drawable/ic_fps"
                                        app:tint="#0A84FF" />

                                    <TextView
                                        android:id="@+id/capsuleFpsText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:fontFamily="@font/roboto"
                                        android:text="60 FPS"
                                        android:textColor="#F5F5F7"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        tools:text="60 FPS" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </RelativeLayout>

                        <!-- Botón Circular Central INICIAR (LiquidStartButton) -->
                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="10dp">

                            <com.limelight.ui.effects.LiquidStartButton
                                android:id="@+id/liquidStartButton"
                                android:layout_width="118dp"
                                android:layout_height="118dp"
                                android:layout_gravity="center"
                                android:clickable="true"
                                android:focusable="true"
                                android:contentDescription="Iniciar conexión" />
                        </FrameLayout>

                        <!-- Chip de Última Conexión estilo iOS Pill -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/last_session_card"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:visibility="gone"
                            app:cardBackgroundColor="#47141C2B"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#59FFFFFF"
                            app:strokeWidth="1.2dp"
                            tools:visibility="visible">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp">

                                <TextView
                                    android:id="@+id/last_session_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto"
                                    android:text="Última sesión:"
                                    android:textColor="#8E8E93"
                                    android:textSize="10sp"
                                    tools:text="Última sesión:" />

                                <TextView
                                    android:id="@+id/last_session_subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:fontFamily="@font/roboto"
                                    android:text="Escritorio"
                                    android:textColor="#0A84FF"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    tools:text="Escritorio" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 7. Encabezado Sección "Mis equipos" estilo Apple Inset Grouped -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginHorizontal="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/devicesTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto"
                        android:text="MIS EQUIPOS"
                        android:textColor="#8E8E93"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddPcQuick"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minHeight="36dp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="0dp"
                        android:text="@string/nav_add_pc"
                        android:textColor="#0A84FF"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_add"
                        app:iconSize="16dp"
                        app:iconTint="#0A84FF" />
                </LinearLayout>

                <!-- 8. Lista de Dispositivos (RecyclerView) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/pc_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="8dp"
                    tools:itemCount="3"
                    tools:listitem="@layout/pc_grid_item" />

                <!-- 9. Panel Radar cuando no hay equipos detectados -->
                <LinearLayout
                    android:id="@+id/no_pc_found_layout"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_radar_panel"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone">

                    <com.limelight.ui.RadarView
                        android:id="@+id/radar"
                        android:layout_width="84dp"
                        android:layout_height="84dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto"
                            android:text="@string/searching_pc"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/roboto"
                            android:text="Escaneando dispositivos en tu red local."
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/pcs_loading_button"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginTop="6dp"
                            android:backgroundTint="?attr/colorSurfaceContainerHigh"
                            android:text="Buscar de nuevo"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- HEADER FLOTANTE DYNAMIC PILL (Apple iOS 18 Glass)              -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_gravity="top"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ios_glass_pill"
            android:elevation="10dp"
            android:paddingHorizontal="8dp">

            <!-- Botón Menú Lateral -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/nav_manual"
                app:icon="@drawable/ic_menu"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="#FFFFFF"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Título SmartDisplay Flotante y Estilizado -->
            <LinearLayout
                android:id="@+id/titleContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto"
                    android:text="Smart"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto"
                    android:text="Display"
                    android:textColor="#0A84FF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />
            </LinearLayout>

            <!-- Botón Agregar PC Flotante (+) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_pc_top"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/add_computer"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="#FFFFFF"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Toolbar oculta mantenida para compatibilidad de menús nativos -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:menu="@menu/toolbar_pc_view"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Barra Lateral Delgada con Iconos (Slim Icon Navigation Rail) -->
    <include
        android:id="@+id/slim_nav_rail"
        layout="@layout/layout_slim_nav_rail"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>