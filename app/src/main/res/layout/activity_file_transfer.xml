<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ft_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ios_ambient_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- HEADER: Cápsula Flotante Glass iOS · Volver + Título & Estado  -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ftHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_ios_glass_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <com.limelight.ui.glass.LiquidGlassCircleLayout
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/settings_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@string/settings_back"
                android:src="@drawable/ic_back_arrow"
                app:tint="#F8FAFC" />
        </com.limelight.ui.glass.LiquidGlassCircleLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnClose"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto"
                android:includeFontPadding="false"
                android:text="@string/ft_title"
                android:textColor="#F8FAFC"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ft_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/roboto"
                android:includeFontPadding="false"
                android:textColor="#7DDAFF"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="● Servidor activo" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- CONTENIDO: Radar AirDrop · Tarjeta Enlace · Enviar · Recibidos -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="40dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="440dp">

                <!-- 1. Radar AirDrop Animado Hiperrealista -->
                <com.limelight.ui.glass.AirDropRadarView
                    android:id="@+id/airdrop_radar"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp" />

                <!-- 2. Tarjeta Glass iOS con la URL para el navegador del PC -->
                <com.limelight.ui.glass.IosGlassCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_lan"
                                app:tint="#7DDAFF" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/roboto"
                                android:includeFontPadding="false"
                                android:text="Punto de Enlace WiFi"
                                android:textColor="#7DDAFF"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_status_chip"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="HTTP 8080"
                                android:textColor="#94A3B8"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/ft_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="monospace"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp"
                            android:textColor="#F8FAFC"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textIsSelectable="true"
                            tools:text="http://192.168.1.15:8080" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/roboto"
                            android:gravity="center"
                            android:text="Abre este enlace en el navegador web de tu PC para transferir archivos."
                            android:textColor="#94A3B8"
                            android:textSize="12sp" />

                        <!-- Botón Copiar Enlace con Retroalimentación Háptica -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_copy_url"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_ios_glass_button_secondary"
                            android:stateListAnimator="@animator/card_press_scale"
                            android:text="Copiar dirección"
                            android:textColor="#F8FAFC"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_copy"
                            app:iconGravity="textStart"
                            app:iconSize="18dp"
                            app:iconTint="#7DDAFF" />

                    </LinearLayout>
                </com.limelight.ui.glass.IosGlassCardView>

                <!-- 3. Sección Móvil -> Laptop (Compartir con el PC) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto"
                        android:text="@string/ft_share_section"
                        android:textColor="#F8FAFC"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ft_shared_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_chip"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="0 archivos"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ft_btn_share"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_ios_glass_button_secondary"
                    android:stateListAnimator="@animator/card_press_scale"
                    android:text="@string/ft_share_action"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_files_overlay"
                    app:iconSize="20dp"
                    app:iconTint="#7DDAFF" />

                <!-- Lista dinámica de archivos compartidos (Móvil -> PC) -->
                <LinearLayout
                    android:id="@+id/ft_shared_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <!-- 4. Sección Laptop -> Móvil (Archivos Recibidos) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto"
                        android:text="@string/ft_received_section"
                        android:textColor="#F8FAFC"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ft_received_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_chip"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="0 recibidos"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ft_btn_received"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_ios_glass_button_secondary"
                    android:stateListAnimator="@animator/card_press_scale"
                    android:text="@string/ft_received_refresh"
                    android:textColor="#F8FAFC"
                    android:textSize="13.5sp"
                    app:backgroundTint="@null"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_refresh"
                    app:iconSize="18dp"
                    app:iconTint="#94A3B8" />

                <TextView
                    android:id="@+id/ft_received"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/roboto"
                    android:textColor="#94A3B8"
                    android:textSize="12.5sp" />

                <!-- Estado vacío interactivo estilo Apple Continuity -->
                <LinearLayout
                    android:id="@+id/ft_empty_received"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_ios_card_tile"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_computer"
                        app:tint="#4DFFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/roboto"
                        android:text="A la espera de envíos del PC"
                        android:textColor="#E2E8F0"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/roboto"
                        android:gravity="center"
                        android:text="Sube archivos desde el navegador de tu laptop y aparecerán aquí al instante."
                        android:textColor="#94A3B8"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- Lista dinámica de archivos recibidos (PC -> Móvil) -->
                <LinearLayout
                    android:id="@+id/ft_received_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>