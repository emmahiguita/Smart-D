<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta HUD / Explorador de archivos en Cristal Translúcido OLED estilo iOS 18 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa 1: Fondo translúcido ahumado oscuro -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#E6080C16" />
        </shape>
    </item>

    <!-- Capa 2: Superficie de cristal refractivo con degradado de luz -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:startColor="#33243552"
                android:centerColor="#1F152033"
                android:endColor="#140E1422"
                android:angle="270" />
            <stroke
                android:width="1.2dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>

    <!-- Capa 3: Micro-borde etéreo zafiro interior -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <stroke
                android:width="0.8dp"
                android:color="#2B0A84FF" />
        </shape>
    </item>
</layer-list>
