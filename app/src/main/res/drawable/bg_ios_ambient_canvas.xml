<?xml version="1.0" encoding="utf-8"?>
<!-- Lienzo ambiental OLED con resplandor espectral difuso para refracción de cristal -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo base: Negro Obsidiana Profundo OLED -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#04060A" />
        </shape>
    </item>

    <!-- Resplandor ambiental superior (Apple Electric Blue difuminado) -->
    <item android:bottom="450dp" android:left="-80dp" android:right="-80dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="360dp"
                android:startColor="#2A0A84FF"
                android:centerColor="#100A84FF"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Resplandor ambiental secundario centro-derecha (Apple Indigo / Violeta etéreo) -->
    <item android:top="220dp" android:bottom="200dp" android:left="80dp" android:right="-120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="340dp"
                android:startColor="#1E5E5CE6"
                android:centerColor="#0A5E5CE6"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Gradiente de viñeta suave general -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0A000000"
                android:centerColor="#00000000"
                android:endColor="#4D020305"
                android:angle="270" />
        </shape>
    </item>
</layer-list>
