<?xml version="1.0" encoding="utf-8"?>
<!-- Cápsula Flotante en Cristal Zafiro Translúcido con Bisel Especular -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa 1: Sombra y tinte ahumado de cristal -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#4D0C101A" />
        </shape>
    </item>

    <!-- Capa 2: Superficie de vidrio translúcido con gradiente de luz -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:startColor="#66263552"
                android:centerColor="#471A2438"
                android:endColor="#33101626"
                android:angle="90" />
            <stroke
                android:width="1.2dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>

    <!-- Capa 3: Micro-borde interno reflectante -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <stroke
                android:width="0.8dp"
                android:color="#330A84FF" />
        </shape>
    </item>
</layer-list>
