<?xml version="1.0" encoding="utf-8"?>
<!-- Mosaico HomeKit / Tarjeta de Dispositivo en Cristal Translúcido -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa 1: Tinte ahumado profundo -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#470E121C" />
        </shape>
    </item>

    <!-- Capa 2: Superficie de cristal ahumado translúcido -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#59202B3E"
                android:centerColor="#3D141C2B"
                android:endColor="#2B0E1420"
                android:angle="270" />
            <stroke
                android:width="1.2dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>

    <!-- Capa 3: Reflejo sutil de cristal interno -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <stroke
                android:width="0.7dp"
                android:color="#2678A6D8" />
        </shape>
    </item>
</layer-list>
