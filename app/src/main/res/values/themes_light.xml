<?xml version="1.0" encoding="utf-8"?>
<!--
  Variantes CLARAS EXPRESSIVE (Material 3 Expressive) de los 7 temas.
  Define neutros luminosos de alta gama, elevaciones tonales escalonadas y
  colores de acento con alto croma (vibrantes y de máxima legibilidad).
-->
<resources>

    <!-- Base clara Expressive: neutros luminosos Material 3 Expressive -->
    <style name="Theme.SmartDisplayAI.Light" parent="Theme.SmartDisplayAI">
        <item name="android:colorBackground">#F8F9FE</item>
        <item name="colorOnBackground">#191C20</item>
        <item name="colorSurface">#FCFCFF</item>
        <item name="colorOnSurface">#191C20</item>
        <item name="colorSurfaceVariant">#DFE2ED</item>
        <item name="colorOnSurfaceVariant">#434751</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#F2F4FB</item>
        <item name="colorSurfaceContainer">#ECEDF5</item>
        <item name="colorSurfaceContainerHigh">#E5E7F0</item>
        <item name="colorSurfaceContainerHighest">#DFE2EB</item>
        <item name="colorOutline">#737782</item>
        <item name="colorOutlineVariant">#C3C6D2</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- BottomSheet en modo claro: usa colorSurfaceContainer blanco-grisáceo -->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.SmartDisplay.BottomSheet.Light</item>
    </style>

    <!-- 1. Universo · Claro Expressive (Violeta Neón / Cian Eléctrico) -->
