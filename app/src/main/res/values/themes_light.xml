        <item name="colorOnPrimaryContainer">#2E1065</item>
        <item name="colorSecondary">#0891B2</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#CFFAFE</item>
        <item name="colorOnSecondaryContainer">#164E63</item>
        <item name="colorTertiary">#E11D48</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#FFE4E6</item>
        <item name="colorOnTertiaryContainer">#881337</item>
    </style>

